# In local dev you can leave this unset — Vite's dev-server proxy (see vite.config.js)
# forwards "/api" to http://localhost:5000 automatically.
#
# In production (e.g. deploying to Render, Netlify, Vercel as a static site separate
# from the backend), this MUST be set at build time to your deployed backend's URL:
VITE_API_URL=https://your-backend-service.onrender.com/api
