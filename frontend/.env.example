# Local development — Vite's dev-server proxy (see vite.config.js) can also handle
# "/api" automatically, but setting this explicitly works too and matches production.
VITE_API_URL=http://localhost:5000/api

# Production (Render) — uncomment this and comment out the line above before/when
# building for production. VITE_API_URL is read at BUILD time, so after changing it
# you must rebuild/redeploy the frontend, not just restart it.
#VITE_API_URL=https://wire-backend-67ir.onrender.com/api
